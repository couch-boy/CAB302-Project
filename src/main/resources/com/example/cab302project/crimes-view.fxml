<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.cab302project.CrimesController"
           fx:id="crimesRoot"
           stylesheets="@styles.css"
           style="-fx-background-color: #F8F9FA;">

    <VBox spacing="0">

        <!-- App bar -->
        <HBox styleClass="app-bar" alignment="CENTER_LEFT" spacing="0">
            <Button fx:id="hamburgerBtn" styleClass="hamburger-btn">
                <graphic><FontIcon iconLiteral="fas-bars" iconSize="18" iconColor="#2A364E"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" spacing="2">
                <Label text="RADIUS" styleClass="app-bar-title"/>
                <Label text="Crime Reports"
                       style="-fx-text-fill: #6B7280; -fx-font-size: 10px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Region minWidth="40"/>
        </HBox>

        <!-- Tab bar -->
        <HBox styleClass="tab-bar">
            <Button fx:id="listTabBtn" text="List"
                    onAction="#onListTabClick"
                    styleClass="tab-btn"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="mapTabBtn" text="Map"
                    onAction="#onMapTabClick"
                    styleClass="tab-btn"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

        <!-- List pane -->
        <VBox fx:id="listPane" VBox.vgrow="ALWAYS" spacing="0">

            <!-- Severity legend -->
            <HBox fx:id="severityLegendStrip" alignment="CENTER_LEFT" spacing="16"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 8 20 8 20;
                         -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                <Label text="●" style="-fx-text-fill: #DC143C; -fx-font-size: 11px;"/>
                <Label text="Severe" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
                <Label text="●" style="-fx-text-fill: #FF8C00; -fx-font-size: 11px;"/>
                <Label text="Moderate" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
                <Label text="●" style="-fx-text-fill: #FFD700; -fx-font-size: 11px;"/>
                <Label text="Low" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
            </HBox>

            <!-- Crime list -->
            <VBox VBox.vgrow="ALWAYS" spacing="0">

                <!-- Hidden TableView - all existing controller logic depends on this -->
                <TableView fx:id="crimeTable"
                           visible="false" managed="false">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID"/>
                        <TableColumn fx:id="categoryColumn" text="Category"/>
                        <TableColumn fx:id="severityColumn" text="Severity"/>
                        <TableColumn fx:id="timestampColumn" text="Date/Time"/>
                        <TableColumn fx:id="actionedColumn" text="Status"/>
                    </columns>
                </TableView>

                <!-- Section header -->
                <HBox fx:id="sectionHeader" alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 12 20 8 20; -fx-background-color: #F8F9FA;">
                    <Label fx:id="recentLabel" text="Recent"
                           style="-fx-text-fill: #1A1A2E; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                </HBox>

                <!--
                    Hidden MenuButton and RadioMenuItems - kept invisible/unmanaged so
                    updateFilterButtonText() can write to filterMenuButton without a
                    NullPointerException. The visible filter UI is the compact bar below.
                -->
                <MenuButton fx:id="filterMenuButton"
                            visible="false" managed="false"
                            styleClass="filter-menu-btn">
                    <items>
                        <RadioMenuItem fx:id="severityAllItem"    text="All"      selected="true" onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="severitySevereItem"   text="Severe"   onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="severityModerateItem" text="Moderate" onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="severityLowItem"      text="Low"      onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="crimeTypeAllItem"          text="All"            selected="true" onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="crimeTypeAssaultItem"      text="Assault"        onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="crimeTypeTrespassingItem"  text="Trespassing"    onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="crimeTypeDomesticAbuseItem" text="Domestic Abuse" onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="crimeTypeHomicideItem"     text="Homicide"       onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="statusAllItem"     text="All"     selected="true" onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="statusPendingItem" text="Pending"                onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="dateAllItem"        text="All"          selected="true" onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="dateTodayItem"      text="Today"                     onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="dateLast7DaysItem"  text="Last 7 Days"              onAction="#onFilterChanged"/>
                        <RadioMenuItem fx:id="dateLast30DaysItem" text="Last 30 Days"             onAction="#onFilterChanged"/>
                    </items>
                </MenuButton>

                <!--
                    Compact filter bar. One always-visible row of severity chips that
                    share the full width equally. Crime type and date range are inside
                    the collapsible advanced section toggled by the More button.
                    The public view has no status filter since all public records are Pending.
                -->
                <VBox fx:id="filterBar"
                      style="-fx-background-color: #FFFFFF;
                             -fx-border-color: #E5E7EB;
                             -fx-border-width: 0 0 1 0;
                             -fx-padding: 8 16 8 16;"
                      spacing="6">

                    <!-- Single always-visible row: severity chips + More toggle -->
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <ToggleButton fx:id="chipSevAll" text="All" selected="true"
                                      onAction="#onFilterChanged"
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #2A364E; -fx-text-fill: #FFFFFF;
                                             -fx-background-radius: 20; -fx-border-radius: 20;
                                             -fx-font-size: 11px; -fx-padding: 5 0 5 0;
                                             -fx-cursor: hand; -fx-border-width: 0;"/>
                        <ToggleButton fx:id="chipSevLow" text="Low"
                                      onAction="#onFilterChanged"
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                                             -fx-background-radius: 20; -fx-border-radius: 20;
                                             -fx-font-size: 11px; -fx-padding: 5 0 5 0;
                                             -fx-cursor: hand; -fx-border-width: 0;"/>
                        <ToggleButton fx:id="chipSevModerate" text="Moderate"
                                      onAction="#onFilterChanged"
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                                             -fx-background-radius: 20; -fx-border-radius: 20;
                                             -fx-font-size: 11px; -fx-padding: 5 0 5 0;
                                             -fx-cursor: hand; -fx-border-width: 0;"/>
                        <ToggleButton fx:id="chipSevSevere" text="Severe"
                                      onAction="#onFilterChanged"
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                                             -fx-background-radius: 20; -fx-border-radius: 20;
                                             -fx-font-size: 11px; -fx-padding: 5 0 5 0;
                                             -fx-cursor: hand; -fx-border-width: 0;"/>
                        <Button fx:id="advancedToggleBtn" text="More &#x25BE;"
                                onAction="#onAdvancedToggle"
                                style="-fx-background-color: #F3F4F6;
                                       -fx-text-fill: #6B7280; -fx-font-size: 11px;
                                       -fx-cursor: hand; -fx-border-width: 0;
                                       -fx-background-radius: 20; -fx-padding: 5 12 5 12;"/>
                    </HBox>

                    <!-- Collapsible advanced section: crime type + date range -->
                    <VBox fx:id="filterBarAdvanced" spacing="6"
                          visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Type"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11px;
                                          -fx-font-weight: bold; -fx-min-width: 36;"/>
                            <ComboBox fx:id="filterCrimeTypeCombo"
                                      promptText="All Crime Types"
                                      onAction="#onFilterChanged"
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #F3F4F6;
                                             -fx-border-color: #E5E7EB;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 11px;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Date"
                                   style="-fx-text-fill: #6B7280; -fx-font-size: 11px;
                                          -fx-font-weight: bold; -fx-min-width: 36;"/>
                            <ComboBox fx:id="filterDateCombo"
                                      onAction="#onFilterChanged"
                                      maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      style="-fx-background-color: #F3F4F6;
                                             -fx-border-color: #E5E7EB;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>

                </VBox>

                <!-- Opened report banner - visible only when an unsaved report exists.
                     Tapping it re-opens the detail panel so the user can continue editing. -->
                <VBox fx:id="openedSection"
                      visible="false" managed="false"
                      onMouseClicked="#onOpenedBannerClicked"
                      style="-fx-background-color: #FFF8F0;
                             -fx-border-color: #F59E0B;
                             -fx-border-width: 1;
                             -fx-cursor: hand;
                             -fx-padding: 12 20 12 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="●"
                               style="-fx-text-fill: #F59E0B; -fx-font-size: 16px;"/>
                        <VBox spacing="2">
                            <Label text="Opened Report: Not Submitted"
                                   style="-fx-font-weight: bold; -fx-font-size: 13px;
                                          -fx-text-fill: #92400E;"/>
                            <Label fx:id="openedBannerSubtitle"
                                   text="Tap to continue editing and submit"
                                   style="-fx-font-size: 11px; -fx-text-fill: #B45309;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="›"
                               style="-fx-font-size: 20px; -fx-text-fill: #F59E0B;
                                      -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Styled list view - custom cells built in controller -->
                <ListView fx:id="crimeListView"
                          VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent;
                                 -fx-background: transparent;
                                 -fx-border-width: 0;"/>

                <!-- Submit Report always pinned to bottom -->
                <VBox fx:id="submitStripList" style="-fx-background-color: #FFFFFF;
                             -fx-border-color: #E5E7EB;
                             -fx-border-width: 1 0 0 0;
                             -fx-padding: 12 20 12 20;">
                    <Button text="SUBMIT REPORT"
                            onAction="#onAddNewCrime"
                            maxWidth="Infinity"
                            styleClass="btn-primary"
                            style="-fx-padding: 14 0 14 0;"/>
                </VBox>

                <!-- Bottom navigation bar -->
                <fx:include fx:id="navBar" source="nav-bar.fxml"/>

            </VBox>

        </VBox>

        <!-- Map pane - hidden by default, shown when Map tab is active -->
        <VBox fx:id="mapPane" VBox.vgrow="ALWAYS" spacing="0" visible="false" managed="false">

            <WebView fx:id="crimeMapView" VBox.vgrow="ALWAYS"/>

            <HBox fx:id="mapSeverityLegend" alignment="CENTER_LEFT" spacing="16"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 8 20 8 20;
                         -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
                <Label text="●" style="-fx-text-fill: #DC143C; -fx-font-size: 11px;"/>
                <Label text="Severe" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
                <Label text="●" style="-fx-text-fill: #FF8C00; -fx-font-size: 11px;"/>
                <Label text="Moderate" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
                <Label text="●" style="-fx-text-fill: #FFD700; -fx-font-size: 11px;"/>
                <Label text="Low" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
            </HBox>

            <VBox fx:id="submitStripMap" style="-fx-background-color: #FFFFFF;
                         -fx-border-color: #E5E7EB;
                         -fx-border-width: 1 0 0 0;
                         -fx-padding: 12 20 12 20;">
                <Button text="SUBMIT REPORT"
                        onAction="#onAddNewCrime"
                        maxWidth="Infinity"
                        styleClass="btn-primary"
                        style="-fx-padding: 14 0 14 0;"/>
            </VBox>

            <!-- Bottom navigation bar -->
            <fx:include fx:id="navBarMap" source="nav-bar.fxml"/>

        </VBox>

    </VBox>

    <!-- Crime map floating search overlay -->
    <VBox fx:id="crimeSearchOverlay"
          styleClass="search-overlay"
          StackPane.alignment="TOP_RIGHT"
          maxHeight="-Infinity"
          maxWidth="360"
          pickOnBounds="false"
          visible="false" managed="false">
        <StackPane.margin>
            <Insets top="104" right="12"/>
        </StackPane.margin>
        <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
        <HBox spacing="6" alignment="CENTER_LEFT">
            <TextField fx:id="crimeSearchField"
                       promptText="Search suburb or area..."
                       styleClass="search-field-float"
                       onAction="#onCrimeSearch"
                       HBox.hgrow="ALWAYS"/>
            <Button text="Search" onAction="#onCrimeSearch" styleClass="search-btn-float"/>
            <Button text="✕" onAction="#onCrimeClearSearch" styleClass="icon-btn-float"/>
            <Button fx:id="crimeFilterToggleBtn"
                    onAction="#onCrimeToggleFilter"
                    styleClass="icon-btn-float">
                <graphic><FontIcon iconLiteral="fas-sliders-h" iconSize="14" iconColor="#2A364E"/></graphic>
            </Button>
        </HBox>
        <Label fx:id="crimeSearchStatusLabel" styleClass="search-status-float" maxWidth="Infinity"/>
    </VBox>

    <!-- Crime map filter backdrop -->
    <StackPane fx:id="crimeFilterBackdrop"
               managed="false" visible="false"
               onMouseClicked="#onCrimeBackdropClicked"
               StackPane.alignment="TOP_CENTER">
        <StackPane.margin>
            <Insets top="115" left="12" right="12"/>
        </StackPane.margin>
        <Pane style="-fx-background-color: rgba(0,0,0,0.01);" mouseTransparent="false"/>
        <VBox fx:id="crimeFilterDrawer"
              styleClass="filter-drawer"
              spacing="10"
              StackPane.alignment="TOP_CENTER"
              maxHeight="-Infinity"
              onMouseClicked="#onCrimeFilterDrawerClicked">
            <padding><Insets top="12" right="16" bottom="16" left="16"/></padding>
            <HBox alignment="CENTER_RIGHT">
                <Label text="Filter crimes" styleClass="filter-drawer-title" HBox.hgrow="ALWAYS"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#onCrimeToggleFilter"
                        styleClass="icon-btn-float"
                        style="-fx-font-size: 11px; -fx-padding: 4 8 4 8;"/>
            </HBox>
            <VBox spacing="4">
                <Label text="Crime type" styleClass="filter-drawer-label"/>
                <ComboBox fx:id="crimeCategoryFilter" onAction="#onCrimeFilterChanged"
                          styleClass="filter-drawer-combo" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Severity" styleClass="filter-drawer-label"/>
                <ComboBox fx:id="crimeSeverityFilter" onAction="#onCrimeFilterChanged"
                          styleClass="filter-drawer-combo" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Time range" styleClass="filter-drawer-label"/>
                <ComboBox fx:id="crimeDaysFilter" onAction="#onCrimeFilterChanged"
                          styleClass="filter-drawer-combo" maxWidth="Infinity"/>
            </VBox>
            <Button text="Reset all filters" onAction="#onCrimeResetFilters"
                    maxWidth="Infinity" styleClass="btn-secondary"
                    style="-fx-padding: 10 0 10 0;"/>
        </VBox>
    </StackPane>

    <!-- Dim backdrop -->
    <Pane fx:id="detailBackdrop"
          visible="false" managed="false"
          onMouseClicked="#onCloseDetail"
          style="-fx-background-color: rgba(0,0,0,0.35);"
          StackPane.alignment="CENTER"/>

    <!-- Bottom sheet detail panel -->
    <VBox fx:id="detailPanel"
          visible="false" managed="false"
          spacing="0"
          maxHeight="600"
          StackPane.alignment="BOTTOM_CENTER"
          style="-fx-background-color: #FFFFFF;
                 -fx-background-radius: 20 20 0 0;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0.3, 0, -4);">

        <!-- Drag handle + close button -->
        <HBox alignment="CENTER" style="-fx-padding: 12 16 0 16;">
            <Region HBox.hgrow="ALWAYS"/>
            <Pane style="-fx-background-color: #D1D5DB;
                         -fx-background-radius: 4;
                         -fx-min-width: 40; -fx-max-width: 40;
                         -fx-min-height: 4; -fx-max-height: 4;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="X" onAction="#onCloseDetail"
                    style="-fx-background-color: #F3F4F6;
                           -fx-text-fill: #6B7280; -fx-cursor: hand;
                           -fx-font-size: 13px; -fx-border-width: 0;
                           -fx-background-radius: 50;
                           -fx-min-width: 28; -fx-min-height: 28;"/>
        </HBox>

        <!-- Sheet title -->
        <HBox alignment="CENTER_LEFT"
              style="-fx-padding: 10 20 12 20;
                     -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
            <Label text="Report Details" styleClass="auth-label" style="-fx-font-size: 15px;"/>
        </HBox>

        <!-- Read-only view scroll pane (shown for existing submitted crimes) -->
        <ScrollPane fx:id="viewScrollPane"
                    fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-width: 0;">
            <VBox spacing="16" style="-fx-padding: 20 20 20 20;">

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Category" styleClass="auth-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailCategoryLabel" text="-"
                           style="-fx-font-weight: bold; -fx-text-fill: #2A364E;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Severity" styleClass="auth-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label fx:id="severityDot" text="●"
                               style="-fx-text-fill: #D1D5DB; -fx-font-size: 13px;"/>
                        <Label fx:id="severityLabel" text="-"
                               style="-fx-font-weight: bold; -fx-text-fill: #6B7280;"/>
                    </HBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Date and Time" styleClass="auth-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailDateLabel" text="-"
                           style="-fx-text-fill: #2A364E;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Status" styleClass="auth-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="detailStatusLabel" text="-"
                           style="-fx-font-weight: bold; -fx-text-fill: #2A364E;"/>
                </HBox>

                <VBox spacing="6">
                    <Label text="Location" styleClass="auth-label"/>
                    <TextField fx:id="locationField"
                               editable="false" styleClass="auth-field"
                               style="-fx-opacity: 1;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Description" styleClass="auth-label"/>
                    <TextArea fx:id="descriptionArea"
                              wrapText="true" prefHeight="90"
                              editable="false" styleClass="auth-field"
                              style="-fx-opacity: 1;"/>
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- Editable form scroll pane (shown only when creating a new report) -->
        <ScrollPane fx:id="editScrollPane"
                    fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS"
                    visible="false" managed="false"
                    style="-fx-background-color: transparent; -fx-background: transparent;
                           -fx-border-width: 0;">
            <VBox spacing="16" style="-fx-padding: 20 20 20 20;">

                <VBox spacing="6">
                    <Label text="Category" styleClass="auth-label"/>
                    <ComboBox fx:id="categoryComboBox" maxWidth="Infinity" styleClass="auth-field"/>
                </VBox>

                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label fx:id="severityDotEdit" text="●"
                           style="-fx-text-fill: #D1D5DB; -fx-font-size: 13px;"/>
                    <Label fx:id="severityLabelEdit" text="Select a category"
                           style="-fx-font-weight: bold; -fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
                </HBox>

                <VBox spacing="6">
                    <Label text="Date" styleClass="auth-label"/>
                    <DatePicker fx:id="datePicker" maxWidth="Infinity" styleClass="auth-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Time" styleClass="auth-label"/>
                    <HBox spacing="8">
                        <ComboBox fx:id="hourBox" styleClass="auth-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ComboBox fx:id="minuteBox" styleClass="auth-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <ComboBox fx:id="ampmBox" styleClass="auth-field" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <VBox spacing="6">
                    <Label text="Location" styleClass="auth-label"/>
                    <TextField fx:id="locationFieldEdit" styleClass="auth-field"
                               promptText="Enter address..."/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Description" styleClass="auth-label"/>
                    <TextArea fx:id="descriptionAreaEdit"
                              wrapText="true" prefHeight="90"
                              styleClass="auth-field"
                              promptText="Describe the incident..."/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Reporter" styleClass="auth-label"/>
                    <TextField fx:id="reporterField" styleClass="auth-field" editable="false"
                               style="-fx-opacity: 1;"/>
                </VBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <CheckBox fx:id="anonymousCheckBox"/>
                    <Label text="Submit Anonymously"
                           style="-fx-font-size: 13px; -fx-text-fill: #2A364E;"/>
                </HBox>

            </VBox>
        </ScrollPane>

        <!-- Save Changes button strip - shown only when creating a new report -->
        <VBox fx:id="saveChangesStrip"
              visible="false" managed="false"
              style="-fx-background-color: #FFFFFF;
                     -fx-border-color: #E5E7EB;
                     -fx-border-width: 1 0 0 0;
                     -fx-padding: 12 20 16 20;">
            <Button fx:id="saveBtn"
                    text="Save Changes"
                    onAction="#onSave"
                    maxWidth="Infinity"
                    styleClass="btn-primary"
                    style="-fx-padding: 14 0 14 0;"/>
        </VBox>

    </VBox>

    <!-- HamburgerMenu is added programmatically in CrimesController.initialize() -->

</StackPane>